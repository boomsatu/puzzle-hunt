# ==============================================================================
# BITCOIN PUZZLE HUNTER — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilainya:
#   copy .env.example .env
# ==============================================================================

# 1. PostgreSQL Database URL (Docker Container: puzzle_postgres)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/puzzle_hunt

# 2. REST API & WebSocket Server Binding
PORT=3001
HOST=0.0.0.0

# 3. Alamat Bitcoin Tujuan Auto-Transfer (Instant Sweep saat Kunci Ditemukan)
DEFAULT_DESTINATION_ADDRESS=bc1q8c0uc752amr7v4amswn5vhes37a6ffy4ral6ek

# 4. Bitcoin Node JSON-RPC Endpoint (Untuk broadcast raw transaction tercepat)
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com

# 5. Notifikasi Telegram Instan (Opsional)
# Dapatkan bot token dari @BotFather dan chat ID dari @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 6. Pilihan Environment / Mode Komputasi (local | vps | gpu)
# - local : Mode PC Lokal (sisakan 2 core untuk OS, desktop, browser, dan Postgres)
# - vps   : Mode Linux VPS (maksimalkan core untuk puzzle, sisakan HANYA 1 core untuk OS + PostgreSQL + Web API)
# - gpu   : Mode GPU Hosting (akselerasi hardware NVIDIA CUDA)
HUNT_MODE=local



# 7. Autentikasi Cloud & Dashboard (Keamanan Backend & Frontend)
# Sangat penting saat dideploy ke Cloud / VPS / GPU Hosting
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
AUTH_SECRET=super_secret_puzzle_hunt_auth_key_2026
